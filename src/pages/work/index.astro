---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { experience } from "../../data/experience";
---
<BaseLayout
  title="Selected Projects"
  description="Selected GenAI and machine learning projects by Mohamed Rayen Fekih, grouped by employer."
>
  <header class="page-hero shell page-hero-compact">
    <p class="eyebrow">Portfolio</p>
    <h1>Selected Projects</h1>
    <p>GenAI, semantic search, recommendations, pricing, forecasting, and optimization projects from my work experience.</p>
  </header>
  <section class="page-section shell grouped-projects">
    {experience.map((job) => (
      <section class="project-employer-group">
        <header>
          <div>
            <p class="eyebrow">{job.period}</p>
            <h2>{job.company}</h2>
          </div>
          <p>{job.role}</p>
        </header>
        <div class="role-projects">
          {job.projects.map((project) => (
            <article class="role-project-card">
              <div class="role-project-main">
                <h3>{project.href ? <a href={project.href}>{project.title}</a> : project.title}</h3>
                <p>{project.description}</p>
                <p class="project-contribution"><strong>Contribution:</strong> {project.contribution}</p>
                <div class="tag-row compact-tags">
                  {project.technologies.map((technology) => <span>{technology}</span>)}
                </div>
                {project.href && <a class="text-link" href={project.href}>View project details <span aria-hidden="true">→</span></a>}
              </div>
              {project.metric && (
                <div class="project-metric">
                  <strong>{project.metric.value}</strong>
                  <span>{project.metric.label}</span>
                </div>
              )}
            </article>
          ))}
        </div>
      </section>
    ))}
  </section>
</BaseLayout>
