---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { experience } from "../../data/experience";
---
<BaseLayout
  title="Work Experience"
  description="Work experience of Mohamed Rayen Fekih across AI engineering, machine learning, GenAI, RAG, recommendations, forecasting, and optimization."
>
  <header class="page-hero shell page-hero-compact">
    <p class="eyebrow">Career</p>
    <h1>Work Experience</h1>
    <p>AI and machine learning roles covering project development, deployment, optimization, and customer delivery.</p>
  </header>
  <section class="page-section shell experience-list">
    {experience.map((job) => (
      <article class="experience-item">
        <div class="experience-meta">
          <p>{job.period}</p>
          <span>{job.location}</span>
        </div>
        <div class="experience-copy">
          <p class="eyebrow">{job.company}</p>
          <h2>{job.role}</h2>
          <p class="experience-summary">{job.summary}</p>
          <ul>
            {job.responsibilities.map((item) => <li>{item}</li>)}
          </ul>
          <div class="experience-project-list">
            {job.projects.map((project) => (
              <article>
                <div>
                  <h3>{project.href ? <a href={project.href}>{project.title}</a> : project.title}</h3>
                  <p>
                    {project.description}
                    {project.externalUrl && (
                      <>
                        {" "}
                        <a class="inline-project-link" href={project.externalUrl} target="_blank" rel="noopener noreferrer">
                          {project.externalLabel ?? "Visit live project"} <span aria-hidden="true">↗</span>
                        </a>
                      </>
                    )}
                  </p>
                  {project.client && <p class="project-client"><strong>Client:</strong> {project.client}</p>}
                  <p class="project-contribution"><strong>Contribution:</strong> {project.contribution}</p>
                  <div class="tag-row compact-tags">
                    {project.technologies.map((technology) => <span>{technology}</span>)}
                  </div>
                </div>
                {project.metrics && (
                  <div class="project-metrics">
                    {project.metrics.map((metric) => (
                      <div class="project-metric">
                        <strong>{metric.value}</strong>
                        <span>{metric.label}</span>
                      </div>
                    ))}
                  </div>
                )}
              </article>
            ))}
          </div>
        </div>
      </article>
    ))}
    <article class="experience-item education-item">
      <div class="experience-meta">
        <p>2016 - 2021</p>
        <span>Tunis, Tunisia</span>
      </div>
      <div class="experience-copy">
        <p class="eyebrow">National Engineering School of Tunis</p>
        <h2>MS in Computer Science</h2>
      </div>
    </article>
  </section>
</BaseLayout>
