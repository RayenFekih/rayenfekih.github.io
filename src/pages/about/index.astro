---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { siteConfig } from "../../config/site";
---
<BaseLayout
  title="About"
  description="About Mohamed Rayen Fekih, an AI and Machine Learning Engineer based in Tunisia."
>
  <header class="page-hero shell page-hero-compact">
    <p class="eyebrow">Profile</p>
    <h1>About</h1>
  </header>
  <section class="page-section shell about-grid">
    <div class="prose about-copy">
      <p class="about-lead">
        I am Mohamed Rayen Fekih, a Senior AI / Machine Learning Engineer based in Tunis, Tunisia.
      </p>
      <p>
        I have experience developing GenAI, RAG, semantic search, recommendation,
        forecasting, pricing, and process-optimization systems. My work covers data
        preparation, model development, evaluation, deployment, and production support.
      </p>
      <p>
        I currently work on Arabic GenAI applications using Google Cloud, Vertex AI,
        BigQuery, Gemini models, and managed retrieval services. Earlier roles focused
        on enterprise recommendation, pricing, retail forecasting, and manufacturing optimization.
      </p>
      <h2>Professional strengths</h2>
      <ul>
        <li>End-to-end ownership from data preparation to deployment.</li>
        <li>Experience with Arabic retrieval and domain-specific AI applications.</li>
        <li>Practical implementation of evaluation and human-review workflows.</li>
        <li>Communication in Arabic, English, and French.</li>
      </ul>
      <div class="button-row">
        <a class="button" href="mailto:rayen.fekih6@gmail.com">Email <Icon name="mail" /></a>
        <a class="button button-secondary" href={siteConfig.cvPath} download>Download CV <Icon name="download" /></a>
      </div>
    </div>
    <aside class="about-sidebar">
      <div class="profile-monogram">MRF</div>
      <dl>
        <div><dt>Location</dt><dd>Tunis, Tunisia</dd></div>
        <div><dt>Current role</dt><dd>AI Engineer</dd></div>
        <div><dt>Languages</dt><dd>Arabic · English · French</dd></div>
        <div><dt>Specialization</dt><dd>GenAI · RAG · Machine Learning · GCP</dd></div>
      </dl>
      <div class="about-links">
        <a href="https://www.linkedin.com/in/rayen-fekih/" target="_blank" rel="noopener noreferrer">LinkedIn <span>↗</span></a>
        <a href="https://github.com/RayenFekih" target="_blank" rel="noopener noreferrer">GitHub <span>↗</span></a>
        <a href="mailto:rayen.fekih6@gmail.com">Email <span>↗</span></a>
      </div>
    </aside>
  </section>
</BaseLayout>
