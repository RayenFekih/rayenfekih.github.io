---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import ArchitectureDiagram from "../components/ArchitectureDiagram.astro";

const { project } = Astro.props as { project: CollectionEntry<"projects"> };
const { data } = project;
---
<BaseLayout title={data.title} description={data.summary} type="article">
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CreativeWork",
      name: data.title,
      description: data.summary,
      author: {
        "@type": "Person",
        name: "Mohamed Rayen Fekih",
        url: "https://rayenfekih.github.io"
      }
    })}
  />
  <article>
    <header class="case-hero shell">
      <a class="back-link" href="/work/">← All case studies</a>
      <div class="case-hero-grid">
        <div>
          <p class="eyebrow">{data.employer} · {data.period}</p>
          <h1>{data.title}</h1>
          <p class="case-summary">{data.summary}</p>
        </div>
        <dl class="case-facts">
          <div><dt>Role</dt><dd>{data.role}</dd></div>
          <div><dt>Scale</dt><dd>{data.scale}</dd></div>
          <div><dt>Focus</dt><dd>{data.capabilities.join(" · ")}</dd></div>
        </dl>
      </div>
      <div class="metric-row case-metrics">
        {data.metrics.map((metric) => <div><strong>{metric.value}</strong><span>{metric.label}</span></div>)}
      </div>
    </header>
    <div class="case-body shell">
      <aside class="case-aside">
        <p class="eyebrow">Project details</p>
        <nav aria-label="On this page">
          <a href="#context">Context</a>
          <a href="#architecture">Architecture</a>
          <a href="#implementation">Implementation</a>
          <a href="#evaluation">Evaluation</a>
          <a href="#deployment">Deployment</a>
          <a href="#results">Results</a>
        </nav>
        <p class="confidentiality">{data.confidentiality}</p>
      </aside>
      <div class="case-content prose">
        <section class="case-lead">
          <p class="eyebrow">Project summary</p>
          <p>{data.problem}</p>
        </section>
        <section id="architecture">
          <ArchitectureDiagram type={data.diagramType} label={`${data.title} architecture`} />
        </section>
        <slot />
        <section class="technology-section">
          <h2>Technology</h2>
          <div class="tag-row">
            {data.technologies.map((technology) => <span>{technology}</span>)}
          </div>
        </section>
      </div>
    </div>
  </article>
</BaseLayout>
