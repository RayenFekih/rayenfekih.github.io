---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import ArchitectureDiagram from "../components/ArchitectureDiagram.astro";
import HadithDiagram from "../components/HadithDiagram.astro";

const { project } = Astro.props as { project: CollectionEntry<"projects"> };
const { data } = project;
const usesOutputLabel = ["computer-vision", "football-analytics"].includes(data.diagramType);
const externalLinks = data.externalLinks ?? (data.externalUrl
  ? [{ url: data.externalUrl, label: data.externalLabel ?? "Visit live project" }]
  : []);
---
<BaseLayout title={data.title} description={data.summary} type="article">
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CreativeWork",
      name: data.title,
      description: data.summary,
      ...(data.externalUrl ? { url: data.externalUrl } : {}),
      author: {
        "@type": "Person",
        name: "Mohamed Rayen Fekih",
        url: "https://rayenfekih.github.io"
      }
    })}
  />
  <article>
    <header class="case-hero shell">
      <a class="back-link" href="/work/">← All case studies</a>
      <div class="case-hero-grid">
        <div>
          <p class="eyebrow">{data.employer} · {data.period}</p>
          <h1>{data.title}</h1>
          <p class="case-summary">{data.summary}</p>
          {externalLinks.length > 0 && (
            <div class="case-project-links">
              {externalLinks.map((link) => (
                <a class="button case-external-link" href={link.url} target="_blank" rel="noopener noreferrer">
                  {link.label} <span aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          )}
        </div>
        <dl class="case-facts">
          <div><dt>Role</dt><dd>{data.role}</dd></div>
          {data.client && <div><dt>Client</dt><dd>{data.client}</dd></div>}
          <div><dt>Scale</dt><dd>{data.scale}</dd></div>
          <div><dt>Focus</dt><dd>{data.capabilities.join(" · ")}</dd></div>
        </dl>
      </div>
      <div class="metric-row case-metrics">
        {data.metrics.map((metric) => <div><strong>{metric.value}</strong><span>{metric.label}</span></div>)}
      </div>
    </header>
    <div class="case-body shell">
      <aside class="case-aside">
        <p class="eyebrow">Project details</p>
        <nav aria-label="On this page">
          <a href="#context">Context</a>
          <a href="#architecture">Architecture</a>
          <a href="#implementation">Implementation</a>
          <a href="#evaluation">Evaluation</a>
          <a href="#deployment">{data.diagramType === "hadith-detection" ? "Installation" : usesOutputLabel ? "Output" : "Deployment"}</a>
          <a href="#results">Results</a>
        </nav>
        <p class="confidentiality">{data.confidentiality}</p>
        <section class="case-sidebar-tech" aria-labelledby="case-technology">
          <p class="eyebrow" id="case-technology">Technology</p>
          <div class="tag-row">
            {data.technologies.map((technology) => <span>{technology}</span>)}
          </div>
        </section>
      </aside>
      <div class:list={["case-content prose", { "library-case": data.diagramType === "hadith-detection" }]}>
        <section class="case-lead">
          <p class="eyebrow">Project summary</p>
          <p>{data.problem}</p>
        </section>
        <section id="architecture">
          {data.diagramType === "hadith-detection"
            ? <HadithDiagram />
            : <ArchitectureDiagram type={data.diagramType} label={`${data.title} architecture`} />}
        </section>
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .case-project-links { display: flex; flex-wrap: wrap; gap: 12px; }
  .library-case { min-width: 0; }
  .library-case :global(pre) { max-width: 100%; overflow-x: auto; padding: 18px; border: 1px solid var(--line); border-radius: var(--radius); }
  .library-case :global(table) { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; font-size: 14px; }
  .library-case :global(th), .library-case :global(td) { padding: 10px 12px; text-align: left; border-bottom: 1px solid var(--line); }
</style>
