---
import type { OpenSourceProject } from "../data/openSource";
import { projectCategoryLabels } from "../data/projectCategories";

const { project } = Astro.props as { project: OpenSourceProject };
---
<article class="role-project-card" data-project-card data-categories={project.categories.join(" ")}>
  <div class="role-project-main">
    <h3><a href={project.href}>{project.title}</a></h3>
    <p>{project.description}</p>
    <p class="project-contribution"><strong>Contribution:</strong> {project.contribution}</p>
    <div class="project-category-row" aria-label="Project categories">
      {project.categories.map((category) => <span>{projectCategoryLabels[category]}</span>)}
    </div>
    <div class="tag-row compact-tags">
      {project.technologies.map((technology) => <span>{technology}</span>)}
    </div>
    <div class="open-source-links">
      <a class="text-link" href={project.href}>View project details <span aria-hidden="true">→</span></a>
      {project.links.map((link) => (
        <a class="text-link" href={link.url} target="_blank" rel="noopener noreferrer">
          {link.label} <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </div>
  <div class="project-metrics">
    {project.metrics.map((metric) => (
      <div class="project-metric"><strong>{metric.value}</strong><span>{metric.label}</span></div>
    ))}
  </div>
</article>

<style>
  .open-source-links { display: flex; flex-wrap: wrap; gap: 12px 24px; margin-top: 16px; }
  .project-metric strong, .project-metric span { display: block; }
  .project-metric span { margin-top: 5px; }
</style>
