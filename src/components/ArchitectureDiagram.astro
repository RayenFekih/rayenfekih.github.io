---
const { type, label = "Sanitized system architecture" } = Astro.props;

const diagrams = {
  retrieval: {
    nodes: [
      "User query",
      "Gibberish detection",
      "Embedding retrieval",
      "Keyword retrieval",
      "Hybrid ranking",
      "Validation Agent",
      "Summarize selected fatwas",
      "Return retrieved fatwas"
    ],
    accent: 4
  },
  agents: {
    nodes: ["Requirements", "Planner agent", "Retrieval", "Generator", "Evaluator"],
    accent: 4
  },
  "khateeb-workflow": {
    image: "/assets/diagrams/khateeb-workflow.png",
    alt: "Representative Khateeb Assistant workflow showing a Khateeb sermon request, requirement and outline agent, Islamic knowledge base, RAG, sermon generation agent, rules review agent, word count, length validation, revision loop through a modifier agent, sermon output, and Khateeb review.",
    caption:
      "Representative production workflow. Internal prompts, validation criteria, orchestration logic, and deployment details are intentionally omitted."
  },
  "human-loop": {
    nodes: ["User query", "Intent agent", "RAG response", "Risk check", "Scholar handoff"],
    accent: 4
  },
  graph: {
    nodes: ["User request", "Graph router", "Tools", "Memory", "Response"],
    accent: 1
  },
  "content-pipeline": {
    nodes: [
      "Fetch new fatwas",
      "Generate embeddings",
      "Flag sensitive content",
      "Summarize fatwas",
      "TTS audios generation",
      "Generate BM25 artifacts",
      "Publish processed outputs"
    ],
    accent: 6
  }
};

const diagram = diagrams[type as keyof typeof diagrams];
---

<figure class="architecture" aria-label={label}>
  <div class="architecture-topline">
    <span>System view</span>
    <span class="sanitized-label">Sanitized</span>
  </div>

  {"image" in diagram ? (
    <div class="image-diagram-shell">
      <img src={diagram.image} alt={diagram.alt} loading="lazy" decoding="async" />
    </div>
  ) : (
    "nodes" in diagram && (
      <div class="architecture-flow">
        {diagram.nodes.map((node, index) => (
          <>
            <div class:list={["architecture-node", { "node-accent": index === diagram.accent }]}>
              <span class="node-index">{String(index + 1).padStart(2, "0")}</span>
              <span>{node}</span>
            </div>
            {index < diagram.nodes.length - 1 && <span class="flow-arrow" aria-hidden="true">-&gt;</span>}
          </>
        ))}
      </div>
    )
  )}

  <figcaption class:list={[{ "sr-only": "image" in diagram }]}>
    {"caption" in diagram ? diagram.caption : `${label}. Representative flow; proprietary implementation details omitted.`}
  </figcaption>
</figure>

<style>
  .image-diagram-shell {
    overflow-x: auto;
    padding: 12px;
    background: #ffffff;
  }

  .image-diagram-shell img {
    display: block;
    width: 100%;
    min-width: 920px;
    height: auto;
    margin: 0 auto;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 680px) {
    .image-diagram-shell {
      padding: 8px;
    }
  }
</style>
